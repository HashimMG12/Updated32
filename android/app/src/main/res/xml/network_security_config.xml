<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (non-TLS) traffic so MQTT over TCP works in release builds -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
